# Credentials & Tokens (CRITICAL - DO NOT COMMIT)
credentials/
credentials/*
token*.json

# Environment secrets
.env

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Database (recreated at runtime)
app/leads.db
app/lead_detector.db
app/leads.db.backup-retrain
*.sqlite3

# Node / Next.js
frontend/node_modules/
tools/ui-test/node_modules/
node_modules/
frontend/.next/
frontend/out/
frontend/build/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*

# Runtime artifacts (local only)
*.log
/overview*.png
.git-frontend-backup/
.freebuff/
.agents/

# Large binary screenshots - not needed for deployment
*.png
*.jpg
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.ico

# Report files
*.pptx
*.docx
*.pdf
*.txt
!requirements.txt
!render_requirements.txt
!Procfile

# Temp
temp_extracted_imgs/
